# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# OpenAI API key
OPENAI_API_KEY=

# OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Per-request timeout for OpenAI calls in ms (default: 30000). Prevents a slow
# or hung OpenAI request from making the bot look unresponsive for minutes.
OPENAI_TIMEOUT_MS=30000

# How many times the OpenAI SDK retries transient failures (default: 2)
OPENAI_MAX_RETRIES=2

# --- Web search (CS news / live data) ---
# The AI can search the web via OpenAI's built-in web_search tool. This reuses
# OPENAI_API_KEY above — no separate search provider or key is needed.
# Set to false to turn the feature off entirely.
WEB_SEARCH_ENABLED=true
# Model for the search call (must support the Responses web_search tool).
# Leave empty to reuse OPENAI_MODEL.
WEB_SEARCH_MODEL=
# Web search can be slow — its own timeout in ms (default: 45000).
WEB_SEARCH_TIMEOUT_MS=45000

# --- Recent-message context ---
# The AI can pull the last N group messages for context (get_recent_messages).
# How many messages to keep per chat before old ones are pruned (default: 300).
RECENT_MESSAGES_RETENTION=300
# IMPORTANT: to let the bot SEE ordinary group messages (not just mentions and
# replies), disable Group Privacy in @BotFather:
#   @BotFather → /mybots → your bot → Bot Settings → Group Privacy → Turn off
# Without this the recent-message context will only contain mentions/replies.

# Path to SQLite database file
DATABASE_PATH=./data/cs-bot.db

# Max players per gather (default: 5)
DEFAULT_MAX_PLAYERS=5

# --- Langfuse tracing (optional) ---
# Tracing only activates when both keys below are set. Get them from the
# Langfuse UI → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com (default) | US: https://us.cloud.langfuse.com | or a self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace environment shown in the Langfuse UI (e.g. development, staging, production)
LANGFUSE_TRACING_ENVIRONMENT=development
