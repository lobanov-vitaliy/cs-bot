# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# OpenAI API key
OPENAI_API_KEY=

# OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Per-request timeout for OpenAI calls in ms (default: 30000). Prevents a slow
# or hung OpenAI request from making the bot look unresponsive for minutes.
OPENAI_TIMEOUT_MS=30000

# How many times the OpenAI SDK retries transient failures (default: 2)
OPENAI_MAX_RETRIES=2

# Path to SQLite database file
DATABASE_PATH=./data/cs-bot.db

# Max players per gather (default: 5)
DEFAULT_MAX_PLAYERS=5

# --- Langfuse tracing (optional) ---
# Tracing only activates when both keys below are set. Get them from the
# Langfuse UI → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com (default) | US: https://us.cloud.langfuse.com | or a self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace environment shown in the Langfuse UI (e.g. development, staging, production)
LANGFUSE_TRACING_ENVIRONMENT=development
